HOST=0.0.0.0
PORT=3030
TRUST_PROXY=1
DATA_DIR=/var/lib/tcpmm
# Optional; defaults to $DATA_DIR/tcpmm-chat.sqlite.
# CHAT_DB_PATH=/var/lib/tcpmm/tcpmm-chat.sqlite
# Optional; defaults to $DATA_DIR/tcpmm-submissions.sqlite.
# SUBMISSIONS_DB_PATH=/var/lib/tcpmm/tcpmm-submissions.sqlite
ADMIN_USERNAME=admin
# Required only on the first start; remove after the administrator is created.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password
