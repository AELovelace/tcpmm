HOST=0.0.0.0
PORT=3030
TRUST_PROXY=1
DATA_DIR=/var/lib/tcpmm
# Optional; defaults to $DATA_DIR/tcpmm-chat.sqlite.
# CHAT_DB_PATH=/var/lib/tcpmm/tcpmm-chat.sqlite
# Optional; defaults to $DATA_DIR/tcpmm-submissions.sqlite.
# SUBMISSIONS_DB_PATH=/var/lib/tcpmm/tcpmm-submissions.sqlite
# Optional radio overrides; FFmpeg and FFprobe otherwise resolve from PATH.
# MUSIC_DIR=/opt/tcpmm/music
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
ADMIN_USERNAME=admin
# Required only on the first start; remove after the administrator is created.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password
# Optional command-line fallback for server-managed publisher keys. Site administrators
# can generate and immediately revoke keys from the API KEYS panel without this setting.
# Generate an environment entry with:
# npm run generate:show-api-key -- friend
# SHOW_API_KEYS=friend:replace-with-the-generated-sha256-hash
